{
  "name": "reversi-service",
  "version": "1.0.0",
  "description": "A TypeScript Express service for playing Reversi with AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development ts-node src/index.ts",
    "dev:front-end": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:front-end": "vite build",
    "start": "NODE_ENV=production node dist/index.js",
    "prod": "npm run build && npm start",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "reversi",
    "game",
    "ai",
    "aws"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.948.0",
    "antd": "^6.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "openai": "^6.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-typewriter-effect": "^1.1.0"
  }
}
